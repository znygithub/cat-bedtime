#!/usr/bin/env bash
# zzz — Cat Bedtime CLI
# Let the cat take over your Mac at bedtime.

set -e

# Resolve install location
ZZZ_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# If installed globally, ZZZ_ROOT is ~/.timetosleep
# If running from source, ZZZ_ROOT is the project directory
if [ -f "$ZZZ_ROOT/lib/config.sh" ]; then
  LIB_DIR="$ZZZ_ROOT/lib"
  SRC_DIR="$ZZZ_ROOT/src/cli"
elif [ -f "$HOME/.timetosleep/lib/config.sh" ]; then
  LIB_DIR="$HOME/.timetosleep/lib"
  SRC_DIR="$HOME/.timetosleep/src/cli"
else
  # Fallback when lib/i18n is unavailable
  echo "Error: Cat Bedtime / 猫猫困了 is not properly installed."
  echo "Run install.sh first or check your installation."
  exit 1
fi

source "$LIB_DIR/config.sh"
source "$LIB_DIR/i18n.sh"
source "$LIB_DIR/ui.sh"
source "$LIB_DIR/stats.sh"

# ── Commands ─────────────────────────────────────────────────────

cmd_default() {
  # No args: show tonight's status
  if ! config_exists; then
    ui_blank
    ui_moon
    ui_print "  ${DIM}$(msg cli.not_configured)${RESET}"
    ui_blank
    return
  fi

  local bedtime wakeup winddown
  bedtime=$(effective_bedtime)
  wakeup=$(config_get "wakeup")
  winddown=$(config_get "winddown_minutes")
  local configured_bedtime postpone_line=""
  configured_bedtime=$(config_get "bedtime")
  if [ "$bedtime" != "$configured_bedtime" ]; then
    postpone_line="  $(msg cli.tonight.postponed "$configured_bedtime")"
  fi

  local bed_min now_min remaining
  bed_min=$(time_to_minutes "$bedtime")
  now_min=$(now_minutes)
  remaining=$(( bed_min - now_min ))
  (( remaining < 0 )) && (( remaining += 1440 ))

  local hours=$(( remaining / 60 ))
  local mins=$(( remaining % 60 ))
  local eta
  if (( hours > 0 )); then
    eta="$(msg cli.eta_hours "$hours" "$mins")"
  else
    eta="$(msg cli.eta_minutes "$mins")"
  fi

  local active_today
  active_today="$(msg cli.no)"
  is_active_today && active_today="$(msg cli.yes)"

  local skipped_tonight
  skipped_tonight="$(msg cli.no)"
  local skip_reason=""
  local today
  today=$(date +%Y-%m-%d)
  if [ -f "$ZZZ_DIR/skip_tonight" ]; then
    local skip_date
    skip_date=$(head -n 1 "$ZZZ_DIR/skip_tonight" 2>/dev/null || true)
    if [ "$skip_date" = "$today" ]; then
      skipped_tonight="$(msg cli.yes)"
      skip_reason=$(sed -n '2p' "$ZZZ_DIR/skip_tonight" 2>/dev/null || true)
    fi
  fi

  ui_blank
  ui_moon

  if [ "$skipped_tonight" = "$(msg cli.yes)" ]; then
    ui_box "$(printf '%b\n' \
      "${C_GRAY}$(msg cli.skipped.title)${RESET}" \
      "" \
      "  ${skip_reason:-$(msg cli.skipped.note)}" \
      "  $(msg cli.skipped.tomorrow "$bedtime")")"
  elif [ "$active_today" = "$(msg cli.yes)" ] && (( remaining > 0 && remaining < 720 )); then
    if [ -n "$postpone_line" ]; then
      ui_box "$(printf '%b\n' \
        "${BOLD}$(msg cli.tonight.title "$bedtime")${RESET}" \
        "" \
        "$postpone_line" \
        "  $(msg cli.tonight.until "$eta")" \
        "  $(msg cli.tonight.remind "$winddown")" \
        "  $(msg cli.tonight.wakeup "$wakeup")")"
    else
      ui_box "$(printf '%b\n' \
        "${BOLD}$(msg cli.tonight.title "$bedtime")${RESET}" \
        "" \
        "  $(msg cli.tonight.until "$eta")" \
        "  $(msg cli.tonight.remind "$winddown")" \
        "  $(msg cli.tonight.wakeup "$wakeup")")"
    fi
  elif [ "$active_today" = "$(msg cli.no)" ]; then
    ui_box "$(printf '%b\n' \
      "${C_GRAY}$(msg cli.off_day)${RESET}" \
      "" \
      "  $(msg cli.off_day.hint)")"
  else
    ui_box "$(printf '%b\n' \
      "${C_GREEN}$(msg cli.already_asleep)${RESET}" \
      "" \
      "  $(msg cli.tomorrow "$bedtime")")"
  fi

  ui_blank
}

cmd_init() {
  source "$SRC_DIR/init.sh"
}

cmd_status() {
  cmd_default

  # Extended stats
  local summary
  summary=$(stats_summary)
  IFS='|' read -r total completed skipped installed <<< "$summary"

  if (( total > 0 )); then
    ui_print "  ${BOLD}$(msg cli.stats.title)${RESET}"
    ui_print "  ${C_GRAY}────────────────────${RESET}"
    ui_print "  $(msg cli.stats.total)    ${BOLD}$total${RESET}"
    ui_print "  $(msg cli.stats.came)      ${C_GREEN}${BOLD}$completed${RESET}"
    ui_print "  $(msg cli.stats.skipped)      ${C_YELLOW}${BOLD}$skipped${RESET}"
    if (( total > 0 )); then
      local rate
      rate=$(python3 -c "print(f'{$completed/$total*100:.0f}')" 2>/dev/null || echo "?")
      ui_print "  $(msg cli.stats.rate)    ${BOLD}${rate}%${RESET}"
    fi
    ui_blank
  fi
}

cmd_config() {
  if [ $# -eq 0 ]; then
    # Show current config
    if ! config_exists; then
      ui_error "$(msg cli.config.not_configured)"
      return 1
    fi

    local bedtime wakeup winddown
    bedtime=$(config_get "bedtime")
    wakeup=$(config_get "wakeup")
    winddown=$(config_get "winddown_minutes")

    local days_display=""
    local day_names=("" "$(msg day.full.1)" "$(msg day.full.2)" "$(msg day.full.3)" "$(msg day.full.4)" "$(msg day.full.5)" "$(msg day.full.6)" "$(msg day.full.7)")
    local days
    days=$(config_get_array "days")
    while IFS= read -r d; do
      [ -z "$d" ] && continue
      [ -n "$days_display" ] && days_display+="、"
      days_display+="${day_names[$d]}"
    done <<< "$days"

    ui_blank
    ui_header "$(msg cli.config.header)"
    ui_print "  $(msg cli.config.bedtime)        ${BOLD}$bedtime${RESET}"
    ui_print "  $(msg cli.config.wakeup)        ${BOLD}$wakeup${RESET}"
    ui_print "  $(msg cli.config.days)  ${BOLD}$days_display${RESET}"
    ui_print "  $(msg cli.config.winddown)        ${BOLD}$(msg cli.config.winddown_value "$winddown")${RESET}"
    ui_blank
    ui_dim "$(msg cli.config.hint)"
    ui_dim "$(msg cli.config.keys)"
    ui_blank
    return
  fi

  local key="$1" value="$2"

  case "$key" in
    bedtime)
      if [[ ! "$value" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]]; then
        ui_error "$(msg cli.error.time_format)"
        return 1
      fi
      config_set "bedtime" "$value"
      source "$LIB_DIR/schedule.sh"
      schedule_update
      ui_success "$(msg cli.success.bedtime "$value")"
      ;;
    wakeup)
      if [[ ! "$value" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]]; then
        ui_error "$(msg cli.error.time_format)"
        return 1
      fi
      config_set "wakeup" "$value"
      source "$LIB_DIR/schedule.sh"
      schedule_update
      ui_success "$(msg cli.success.wakeup "$value")"
      ;;
    winddown)
      if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value < 5 || value > 120 )); then
        ui_error "$(msg cli.error.winddown_range)"
        return 1
      fi
      config_set "winddown_minutes" "$value"
      source "$LIB_DIR/schedule.sh"
      schedule_update
      ui_success "$(msg cli.success.winddown "$value")"
      ;;
    *)
      ui_error "$(msg cli.error.unknown_key "$key")"
      ui_dim "$(msg cli.error.unknown_keys)"
      return 1
      ;;
  esac
}

cmd_tonight() {
  local action="${1:-}"

  case "$action" in
    off)
      if ! config_exists; then
        ui_error "$(msg cli.config.not_configured)"
        return 1
      fi

      ui_blank
      ui_warn "$(msg cli.tonight.warn)"
      ui_input "$(msg cli.tonight.ask_reason)" skip_reason ""

      if [ -z "$skip_reason" ]; then
        ui_error "$(msg cli.tonight.need_reason)"
        return 1
      fi

      local today
      today=$(date +%Y-%m-%d)
      printf "%s\n%s\n" "$today" "$skip_reason" > "$ZZZ_DIR/skip_tonight"
      stats_record "$today" "skipped:$skip_reason"
      ui_success "$(msg cli.tonight.skipped "$skip_reason")"
      ui_blank
      ;;
    "")
      ui_error "$(msg cli.error.tonight_usage)"
      ;;
    *)
      ui_error "$(msg cli.error.unknown_action "$action")"
      ui_dim "$(msg cli.error.tonight_usage)"
      ;;
  esac
}

cmd_log() {
  if ! config_exists; then
    ui_error "还没有配置。运行 zzz init"
    return 1
  fi

  stats_ensure

  ui_blank
  ui_header "$(msg cli.log.header)"

  local _log_came _log_skipped _log_empty
  _log_came=$(msg cli.log.came)
  _log_skipped=$(msg cli.log.skipped)
  _log_empty=$(msg cli.log.empty)
  python3 -c "
import json
with open('$ZZZ_STATS') as f: d = json.load(f)
records = d.get('records', [])
came = '''$_log_came'''
skipped = '''$_log_skipped'''
empty = '''$_log_empty'''
if not records:
    print(f'  {empty}')
else:
    for r in records[-20:]:
        date = r['date']
        status = r['status']
        if status == 'completed':
            print(f'  \033[38;5;114m🐱\033[0m {date}  {came}')
        else:
            reason = status.replace('skipped:', '') if status.startswith('skipped:') else ''
            extra = f'  \033[2m{reason}\033[0m' if reason else ''
            print(f'  \033[38;5;222m💤\033[0m {date}  {skipped}{extra}')
"
  ui_blank
}

cmd_test() {
  # Quick test: launch the overlay for a fixed number of seconds.
  local seconds="${1:-10}"

  if [ $# -gt 1 ]; then
    ui_error "$(msg cli.error.too_many_args)"
    ui_dim "$(msg cli.error.test_usage)"
    return 1
  fi

  if ! [[ "$seconds" =~ ^[0-9]+$ ]] || (( seconds < 1 || seconds > 120 )); then
    ui_error "$(msg cli.error.test_seconds)"
    ui_dim "$(msg cli.error.test_usage)"
    return 1
  fi

  local overlay="$ZZZ_ROOT/bin/zzz-overlay"
  [ ! -x "$overlay" ] && overlay="$HOME/.timetosleep/bin/zzz-overlay"

  if [ ! -x "$overlay" ]; then
    ui_error "$(msg cli.error.overlay_missing)"
    return 1
  fi

  ui_step "$(msg cli.test.running "$seconds")"
  "$overlay" &
  local pid=$!
  sleep "$seconds"
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true

  ui_success "$(msg cli.test.done)"
}

cmd_uninstall() {
  ui_blank
  ui_moon

  if config_exists; then
    local summary
    summary=$(stats_summary)
    IFS='|' read -r total completed skipped installed <<< "$summary"

    local streak
    streak=$(stats_streak)

    if (( total > 0 )); then
      ui_box "$(printf '%b\n' \
        "${BOLD}$(msg cli.uninstall.stats_title)${RESET}" \
        "" \
        "  $(msg cli.uninstall.nights "$total")" \
        "  $(msg cli.uninstall.visits "$completed" "$total")" \
        "  $(msg cli.uninstall.streak "$streak")")"
      ui_blank
    fi
  fi

  if ! ui_type_confirm "$(msg cli.uninstall.confirm_prompt)" "$(msg cli.uninstall.confirm_phrase)"; then
    ui_blank
    ui_success "$(msg cli.uninstall.cancelled)"
    ui_blank
    return
  fi

  ui_blank
  ui_step "$(msg cli.uninstall.step.schedule)"
  source "$LIB_DIR/schedule.sh"
  schedule_uninstall

  ui_step "$(msg cli.uninstall.step.config)"
  rm -rf "$HOME/.timetosleep"

  ui_step "$(msg cli.uninstall.step.command)"
  rm -f /usr/local/bin/zzz 2>/dev/null || true

  ui_blank
  ui_success "$(msg cli.uninstall.done)"
  ui_print "  ${DIM}$(msg cli.uninstall.farewell)${RESET}"
  ui_blank
}

cmd_help() {
  ui_blank
  ui_moon
  ui_print "  ${BOLD}$(msg cli.help.usage)${RESET}"
  ui_print "  ${C_GRAY}─────────────────────────────${RESET}"
  ui_print "  ${BOLD}zzz${RESET}              $(msg cli.help.default)"
  ui_print "  ${BOLD}zzz init${RESET}         $(msg cli.help.init)"
  ui_print "  ${BOLD}zzz status${RESET}       $(msg cli.help.status)"
  ui_print "  ${BOLD}zzz config${RESET}       $(msg cli.help.config)"
  ui_print "  ${BOLD}zzz config${RESET} ${C_CYAN}<key> <value>${RESET}"
  ui_print "                   $(msg cli.help.config_edit)"
  ui_print "  ${BOLD}zzz tonight off${RESET}  $(msg cli.help.tonight)"
  ui_print "  ${BOLD}zzz log${RESET}          $(msg cli.help.log)"
  ui_print "  ${BOLD}zzz test${RESET} ${C_CYAN}[seconds]${RESET}    $(msg cli.help.test)"
  ui_print "  ${BOLD}zzz uninstall${RESET}    $(msg cli.help.uninstall)"
  ui_print "  ${BOLD}zzz help${RESET}         $(msg cli.help.help)"
  ui_blank
}

# ── Router ───────────────────────────────────────────────────────
case "${1:-}" in
  "")         cmd_default ;;
  init)       cmd_init ;;
  status)     cmd_status ;;
  config)     shift; cmd_config "$@" ;;
  tonight)    shift; cmd_tonight "$@" ;;
  log)        cmd_log ;;
  test)       shift; cmd_test "$@" ;;
  uninstall)  cmd_uninstall ;;
  help|--help|-h) cmd_help ;;
  *)
    ui_error "$(msg cli.error.unknown_command "$1")"
    cmd_help
    exit 1
    ;;
esac
