    "app.name": {
      "zh-Hans": "猫猫困了",
      "zh-Hant": "貓貓困了",
      "en": "Cat Bedtime",
      "ja": "Cat Bedtime",
      "ko": "Cat Bedtime"
    },
    "welcome.title": {
      "zh-Hans": "你打算领养这只小猫吗？",
      "zh-Hant": "你打算領養這隻小貓嗎？",
      "en": "Ready to adopt this little cat?",
      "ja": "この子猫を迎え入れますか？",
      "ko": "이 고양이를 입양할까요?"
    },
    "welcome.body": {
      "zh-Hans": "每天到了约定时间，它都会住进你的电脑\n为了保证它的睡眠，你就不能使用电脑了哦",
      "zh-Hant": "每天到了約定時間，牠都會住進你的電腦\n為了保證牠的睡眠，你就不能使用電腦了哦",
      "en": "Every day at the agreed time, it moves into your Mac.\nWhile it sleeps, you can't use the computer.",
      "ja": "約束の時間になると、この Mac に入ってきます。\nねこが眠っている間は、パソコンを使えません。",
      "ko": "약속한 시간이 되면 Mac 안으로 들어옵니다.\n고양이가 자는 동안에는 컴퓨터를 쓸 수 없어요."
    },
    "welcome.cta": {
      "zh-Hans": "好想养",
      "zh-Hant": "好想養",
      "en": "I'd love to",
      "ja": "迎えたい",
      "ko": "키우고 싶어요"
    },
    "config.bedtime.title": {
      "zh-Hans": "猫猫休眠时间",
      "zh-Hant": "貓貓休眠時間",
      "en": "Cat bedtime",
      "ja": "ねこの就寝時間",
      "ko": "고양이 취침 시간"
